//@version=6
indicator("Swing Structure & Fib PRO v4", shorttitle="SSF Pro", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=300)

// PRO v4 (private use). Educational tool only. Not financial advice.
// NEW in v4: estimated order flow (delta, POC, imbalances, absorption, footprint numbers) built from lower-timeframe candles.
// Analysis: swings, scored zones, BOS/CHoCH, Fibonacci + confluence, key S/R levels, chart patterns.
// System:   setup score (0-10), trade plan (entry / stop / targets), risk sizing, built-in backtest stats,
//           market filters, display modes (Clean / Standard / Full) and focus mode.
// Display modes change ONLY what is drawn. Signals and statistics are identical in every mode.

// ================= Inputs =================
gM = "Display"
mode      = input.string("Standard", "Display mode", options=["Clean", "Standard", "Full"], tooltip="Clean = fewer, stronger items. Standard = balanced. Full = everything. Signals are identical in all modes.", group=gM)
focusMode = input.bool(false, "Focus: only the nearest levels to price", group=gM)
focusN    = input.int(2, "Focus: levels per side", minval=1, maxval=5, group=gM)
showTable = input.bool(true, "Show dashboard", group=gM)
tblPos    = input.string("Top right", "Dashboard position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=gM)

gG = "Signals and trade plan"
sigOn      = input.bool(true, "Show setups and trade plans", group=gG)
sigMin     = input.int(6, "Minimum setup score (0-10)", minval=3, maxval=10, tooltip="Setups below this score are ignored.", group=gG)
gradeA     = input.int(8, "A-grade from score", minval=5, maxval=10, group=gG)
rr1        = input.float(1.5, "Target 1 (R)", minval=0.5, step=0.25, group=gG)
rr2        = input.float(3.0, "Target 2 (R)", minval=1.0, step=0.25, group=gG)
tp1Share   = input.float(0.5, "Share closed at target 1", minval=0.0, maxval=1.0, step=0.1, group=gG)
slBuf      = input.float(0.25, "Stop buffer (x ATR)", minval=0.0, step=0.05, group=gG)
maxRiskAtr = input.float(4.0, "Skip setups with a stop wider than (x ATR)", minval=1.0, step=0.5, group=gG)
cooldown   = input.int(3, "Minimum bars between setups", minval=0, group=gG)
maxHold    = input.int(100, "Close a trade after (bars)", minval=10, group=gG)
maxPlans   = input.int(2, "Trade plans kept on chart", minval=1, maxval=6, group=gG)

gX = "Market filters"
useRegime  = input.bool(true, "Skip dead markets (low ADX)", group=gX)
adxMin     = input.int(15, "Minimum ADX", minval=5, maxval=40, group=gX)
useSession = input.bool(false, "Trade only in selected sessions (UTC)", group=gX)
sessAsia   = input.bool(true, "Asia 00-08", group=gX)
sessLondon = input.bool(true, "London 07-16", group=gX)
sessNY     = input.bool(true, "New York 13-22", group=gX)

gR = "Risk"
acct      = input.float(1000.0, "Account size", minval=1.0, group=gR)
riskPct   = input.float(1.0, "Risk per trade (%)", minval=0.1, maxval=10.0, step=0.1, group=gR)
feePct    = input.float(0.1, "Fee per side (%), used in statistics", minval=0.0, step=0.01, group=gR)
webhookOn = input.bool(false, "Send webhook-ready alert() messages for setups", group=gR)

gO = "Order flow (estimated from intrabars)"
ofMode    = input.string("Markers", "Order flow display", options=["Off", "Markers", "Footprint"], tooltip="Markers: POC line, stacked imbalances, absorption. Footprint: sell x buy numbers per price row on the last few candles (zoom in to read them). Data is ESTIMATED from lower-timeframe candles, not true bid/ask.", group=gO)
ofOn      = input.bool(true, "Use order flow in setup score", group=gO)
ltf       = input.timeframe("1", "Intrabar timeframe", tooltip="Must be lower than the chart timeframe. 1 minute is available on the free plan.", group=gO)
nRows     = input.int(10, "Rows per candle", minval=4, maxval=20, group=gO)
ofBars    = input.int(30, "Candles that get markers", minval=5, maxval=100, group=gO)
fpBars    = input.int(5, "Footprint candles (zoom in to read)", minval=1, maxval=12, group=gO)
imbRatio  = input.float(3.0, "Imbalance ratio (x)", minval=1.5, step=0.5, group=gO)
imbMinPct = input.float(5.0, "Imbalance minimum size (% of candle volume)", minval=1.0, step=1.0, group=gO)
stackMin  = input.int(2, "Stacked imbalance: consecutive rows", minval=2, maxval=5, group=gO)
absorbPct = input.float(30.0, "Absorption: volume in the extreme zone (% of candle)", minval=15.0, maxval=60.0, step=5.0, group=gO)
deltaMin  = input.float(10.0, "Strong delta (% of candle volume)", minval=2.0, step=1.0, group=gO)

gS = "Swings"
len        = input.int(5, "Pivot length", minval=2, tooltip="Bars on each side used to confirm a swing. Higher = fewer, bigger swings.", group=gS)
srcMode    = input.string("Wicks", "Swing source", options=["Wicks", "Bodies"], tooltip="Bodies ignores long wicks.", group=gS)
showLabels = input.bool(true, "Structure labels (HH / HL / LH / LL + score)", group=gS)
showZones  = input.bool(true, "Swing zones", group=gS)
maxZones   = input.int(6, "Max zones on chart (Standard mode)", minval=1, maxval=14, group=gS)
zoneAtr    = input.float(0.3, "Zone thickness (x ATR)", minval=0.05, step=0.05, group=gS)
minScore   = input.int(2, "Minimum swing score to display (Standard mode)", minval=0, maxval=4, group=gS)

gQ = "Swing scoring (each factor = +1)"
volMult     = input.float(1.5, "Volume spike (x 20-bar average)", step=0.1, group=gQ)
rsiHi       = input.int(70, "RSI overbought (for highs)", group=gQ)
rsiLo       = input.int(30, "RSI oversold (for lows)", group=gQ)
swingMul    = input.float(2.0, "Big swing (x ATR from last opposite pivot)", step=0.5, group=gQ)
strongScore = input.int(3, "Highlight swings with score >=", minval=1, maxval=4, group=gQ)

gK = "Key support / resistance"
showKey = input.bool(true, "Key levels (repeated touches)", tooltip="Label shows price and number of touches.", group=gK)
keyTol  = input.float(0.5, "Clustering tolerance (x ATR)", minval=0.1, step=0.1, group=gK)
keyMin  = input.int(3, "Minimum touches", minval=2, maxval=10, group=gK)
keyMax  = input.int(5, "Max key levels shown (Standard mode)", minval=1, maxval=15, group=gK)
showPD  = input.bool(true, "Previous day high / low", group=gK)
showPW  = input.bool(true, "Previous week high / low", group=gK)
showPM  = input.bool(false, "Previous month high / low (always on in Full mode)", group=gK)

gP = "Chart patterns"
showPat  = input.bool(true, "Patterns: M, W, triangles", group=gP)
patTol   = input.float(0.8, "Double top/bottom: max difference between peaks (x ATR)", minval=0.1, step=0.1, group=gP)
patDepth = input.float(2.0, "Minimum pattern height (x ATR)", minval=0.5, step=0.5, group=gP)
patFlat  = input.float(0.6, "Triangle: flat side tolerance (x ATR)", minval=0.1, step=0.1, group=gP)
maxPats  = input.int(3, "Max patterns on chart", minval=1, maxval=10, group=gP)

gB = "Structure breaks"
showStruct = input.bool(true, "BOS / CHoCH (BOS hidden in Clean mode)", group=gB)

gF = "Fibonacci"
showFib  = input.bool(true, "Fibonacci on the last main swing", group=gF)
showGold = input.bool(true, "Golden zone (0.618 - 0.786)", group=gF)
showExt  = input.bool(true, "Extensions (1.272 / 1.618, hidden in Clean mode)", group=gF)
legMul   = input.float(3.0, "Minimum swing size (x ATR)", minval=1.0, step=0.5, group=gF)
fibTol   = input.float(0.25, "Level tolerance (x ATR)", minval=0.05, step=0.05, group=gF)
confMin  = input.int(2, "Min zone score for confluence (star)", minval=0, maxval=4, group=gF)

gD = "Higher timeframe"
htf = input.timeframe("240", "Higher timeframe for bias", tooltip="Bias = HTF close above/below its EMA 50 (previous closed HTF bar, no repaint).", group=gD)

gC = "Colors"
bullCol   = input.color(#00E0A4, "Bullish", group=gC)
bearCol   = input.color(#FF4D6D, "Bearish", group=gC)
goldCol   = input.color(#FFC857, "Fibonacci", group=gC)
extCol    = input.color(#4CC9F0, "Extensions", group=gC)
violCol   = input.color(#A78BFA, "Neutral pattern (symmetrical)", group=gC)
mutedCol  = input.color(#94A3B8, "Neutral", group=gC)
dayCol    = input.color(#60A5FA, "Previous day levels", group=gC)
weekCol   = input.color(#C084FC, "Previous week levels", group=gC)
monthCol  = input.color(#FB923C, "Previous month levels", group=gC)

// ================= Effective display settings (display only) =================
bool isClean = mode == "Clean"
bool isFull  = mode == "Full"
effMinScore = isClean ? 3 : isFull ? 0 : minScore
effMaxZones = isClean ? 3 : isFull ? 12 : maxZones
effKeyMax   = isClean ? 3 : isFull ? 8 : keyMax
bool effExt = showExt and not isClean
bool effPM  = showPM or isFull
tpos = tblPos == "Top left" ? position.top_left : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Bottom left" ? position.bottom_left : position.top_right

// ================= Types =================
type Pat
    int   kind      // 1 double top (M), 2 double bottom (W), 3 symmetrical, 4 ascending, 5 descending triangle
    int   key
    int   state     // 0 forming, 1 confirmed, 2 failed
    int   born
    line  lnA
    line  lnB
    line  lnC
    label lbl
    float neck
    float inval
    int   ub
    float uy
    float us
    int   lbb
    float ly
    float ls
    color col

type Trade
    int    dir
    int    grade     // 2 = A, 1 = B
    int    score
    float  entry
    float  slInit
    float  sl
    float  tp1
    float  tp2
    float  risk
    int    bar0
    int    state     // 0 open, 1 target 1 hit (stop at entry), 2 closed
    float  locked
    float  result
    string outcome
    box    bxWin
    box    bxRisk
    line   lnEntry
    line   lnTp1
    label  lbl
    label  lblEnd

// ================= Calculations =================
atr    = ta.atr(14)
rsi    = ta.rsi(close, 14)
volAvg = ta.sma(volume, 20)
[diP, diM, adxV] = ta.dmi(14, 14)
int hrUTC = hour(time, "UTC")

hiSrc = srcMode == "Bodies" ? math.max(open, close) : high
loSrc = srcMode == "Bodies" ? math.min(open, close) : low
ph = ta.pivothigh(hiSrc, len, len)
pl = ta.pivotlow(loSrc, len, len)

htfBias = request.security(syminfo.tickerid, htf, close[1] > ta.ema(close, 50)[1] ? 1 : -1, lookahead=barmerge.lookahead_on)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_on)
pmh = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_on)
pml = request.security(syminfo.tickerid, "M", low[1], lookahead=barmerge.lookahead_on)

// candle triggers (used as the entry confirmation)
float cBody = math.abs(close - open)
float cRange = high - low
float lowW = math.min(open, close) - low
float upW = high - math.max(open, close)
bool bigEnough = cRange >= 0.4 * atr
bool bullEngulf = close > open and open[1] > close[1] and close >= open[1] and open <= close[1]
bool bearEngulf = close < open and open[1] < close[1] and close <= open[1] and open >= close[1]
bool bullPin = lowW >= 2 * cBody and lowW >= 1.5 * upW and close >= low + 0.6 * cRange
bool bearPin = upW >= 2 * cBody and upW >= 1.5 * lowW and close <= high - 0.6 * cRange
bool bullTrig = bigEnough and (bullEngulf or bullPin)
bool bearTrig = bigEnough and (bearEngulf or bearPin)

// ================= State =================
var float lastPH = na
var float lastPL = na
var int   lastPHbar = na
var int   lastPLbar = na
var int   trend = 0          // 1 = up, -1 = down, 0 = unknown
var bool  phBroken = true
var bool  plBroken = true
var array<float> hiLevels = array.new<float>()
var array<float> loLevels = array.new<float>()

// zones (parallel arrays). zBox element is na when a zone is tracked but not drawn.
var array<box>   zBox    = array.new<box>()
var array<float> zPrice  = array.new<float>()
var array<float> zTop    = array.new<float>()
var array<float> zBot    = array.new<float>()
var array<int>   zScore  = array.new<int>()
var array<bool>  zRes    = array.new<bool>()
var array<bool>  zAlive  = array.new<bool>()

// Fibonacci
var array<line>   fibLines  = array.new<line>()
var array<label>  fibLabels = array.new<label>()
var array<box>    fibBoxes  = array.new<box>()
var array<float>  fibPrices = array.new<float>()
var array<bool>   fibConf   = array.new<bool>()
var array<string> fibNames  = array.new<string>()
var int   fibDir = 0
var float fibStart = na
var float fibEnd = na

// alternating pivot list (for patterns)
var array<float> pivP = array.new<float>()
var array<int>   pivB = array.new<int>()
var array<int>   pivT = array.new<int>()

// key levels (clusters of pivots)
var array<float> kPrice = array.new<float>()
var array<int>   kCount = array.new<int>()
var array<int>   kFirst = array.new<int>()
var array<int>   kLast  = array.new<int>()
var array<line>  keyLines = array.new<line>()
var array<label> keyLbls  = array.new<label>()

// patterns
var array<Pat> pats = array.new<Pat>()
var int lastPatUpBar = -1000
var int lastPatDnBar = -1000

// trades and statistics
var Trade cur = na
var array<Trade> plans = array.new<Trade>()
var int   lastSigBar = -1000
var int   nTrades = 0
var int   nWins = 0
var float sumR = 0.0
var float sumWin = 0.0
var float sumLoss = 0.0
var float equity = 0.0
var float peakEq = 0.0
var float maxDD = 0.0

// order flow row data (reused every bar; first nRows entries are used)
var array<float> rowBuy  = array.new<float>(20, 0.0)
var array<float> rowSell = array.new<float>(20, 0.0)
var array<bool>  rowBI   = array.new<bool>(20, false)
var array<bool>  rowSI   = array.new<bool>(20, false)
var float cvd = 0.0

// ================= Helpers: zones / fib =================
addZone(float price, float half, int bar0, bool isRes, int sc, bool display) =>
    color col = isRes ? bearCol : bullCol
    float top = price + half
    float bot = price - half
    box bx = na
    if display
        bx := box.new(bar0, top, bar0 + 1, bot, border_color=color.new(col, 70), border_width=1, bgcolor=color.new(col, 94 - sc * 4))
    array.push(zBox, bx)
    array.push(zPrice, price)
    array.push(zTop, top)
    array.push(zBot, bot)
    array.push(zScore, sc)
    array.push(zRes, isRes)
    array.push(zAlive, true)
    if array.size(zBox) > 14
        box oldB = array.shift(zBox)
        if not na(oldB)
            box.delete(oldB)
        array.shift(zPrice)
        array.shift(zTop)
        array.shift(zBot)
        array.shift(zScore)
        array.shift(zRes)
        array.shift(zAlive)
    int shown = 0
    int nn = array.size(zBox)
    for i = nn - 1 to 0
        box zi = array.get(zBox, i)
        if not na(zi)
            shown += 1
            if shown > effMaxZones
                box.delete(zi)
                array.set(zBox, i, na)
    true

hasConf(float price, float tol) =>
    bool found = false
    int n = array.size(zPrice)
    if n > 0
        for i = 0 to n - 1
            if array.get(zAlive, i) and array.get(zScore, i) >= confMin and math.abs(array.get(zPrice, i) - price) <= tol
                found := true
    found

buildFib(float sP, float eP, int sBar, int eBar, int dir, float tol, bool doGold, bool doExt) =>
    for l in fibLines
        line.delete(l)
    for lb in fibLabels
        label.delete(lb)
    for b in fibBoxes
        box.delete(b)
    array.clear(fibLines)
    array.clear(fibLabels)
    array.clear(fibBoxes)
    array.clear(fibPrices)
    array.clear(fibConf)
    array.clear(fibNames)

    float legSize = math.abs(eP - sP)
    array.push(fibLines, line.new(sBar, sP, eBar, eP, color=color.new(mutedCol, 40), style=line.style_dotted, width=1))

    if doGold
        float g1p = eP - dir * 0.618 * legSize
        float g2p = eP - dir * 0.786 * legSize
        array.push(fibBoxes, box.new(eBar, math.max(g1p, g2p), eBar + 1, math.min(g1p, g2p), extend=extend.right, border_color=color.new(goldCol, 100), bgcolor=color.new(goldCol, 88)))

    for r in array.from(0.382, 0.5, 0.618, 0.786)
        float p = eP - dir * r * legSize
        bool c = hasConf(p, tol)
        bool key = r >= 0.618
        string nm = str.tostring(r) + (c ? " ★" : "")
        array.push(fibLines, line.new(eBar, p, eBar + 1, p, extend=extend.right, color=c ? goldCol : color.new(goldCol, key ? 35 : 65), width=(c or key) ? 2 : 1))
        array.push(fibLabels, label.new(eBar, p, nm + "  " + str.tostring(p, format.mintick), style=label.style_none, textcolor=c ? goldCol : color.new(goldCol, key ? 15 : 40), size=size.small))
        array.push(fibPrices, p)
        array.push(fibConf, c)
        array.push(fibNames, nm)

    if doExt
        for r in array.from(1.272, 1.618)
            float p = eP + dir * (r - 1) * legSize
            bool c = hasConf(p, tol)
            string nm = str.tostring(r) + (c ? " ★" : "")
            array.push(fibLines, line.new(eBar, p, eBar + 1, p, extend=extend.right, color=color.new(extCol, 25), style=line.style_dashed, width=1))
            array.push(fibLabels, label.new(eBar, p, nm + "  " + str.tostring(p, format.mintick), style=label.style_none, textcolor=extCol, size=size.small))
            array.push(fibPrices, p)
            array.push(fibConf, c)
            array.push(fibNames, nm)
    true

// ================= Helpers: key levels =================
touchLevel(float price, int bar, float tol) =>
    int idx = -1
    int n = array.size(kPrice)
    if n > 0
        for i = 0 to n - 1
            if idx == -1 and math.abs(array.get(kPrice, i) - price) <= tol
                idx := i
    if idx >= 0
        int c = array.get(kCount, idx)
        array.set(kPrice, idx, (array.get(kPrice, idx) * c + price) / (c + 1))
        array.set(kCount, idx, c + 1)
        array.set(kLast, idx, bar)
    else
        array.push(kPrice, price)
        array.push(kCount, 1)
        array.push(kFirst, bar)
        array.push(kLast, bar)
        if array.size(kPrice) > 24
            int wi = 0
            int wc = 1000
            for j = 0 to array.size(kPrice) - 1
                int cj = array.get(kCount, j)
                if cj < wc or (cj == wc and array.get(kLast, j) < array.get(kLast, wi))
                    wi := j
                    wc := cj
            array.remove(kPrice, wi)
            array.remove(kCount, wi)
            array.remove(kFirst, wi)
            array.remove(kLast, wi)
    true

// a label is drawn only if no other label sits within `gap` price units (keeps the right edge readable)
slotFree(array<float> ys, float y, float gap) =>
    bool ok = true
    for v in ys
        if math.abs(v - y) < gap
            ok := false
    ok

drawHtf(float price, string name, color col, array<float> ys, float gap) =>
    if not na(price)
        array.push(keyLines, line.new(bar_index - 120, price, bar_index, price, extend=extend.right, color=color.new(col, 20), style=line.style_dotted, width=1))
        if slotFree(ys, price, gap)
            array.push(keyLbls, label.new(bar_index + 3, price, name + " " + str.tostring(price, format.mintick), style=label.style_none, textcolor=col, size=size.small))
            array.push(ys, price)
    true

// ================= Helpers: patterns =================
addPivot(float p, int b, int t) =>
    int n = array.size(pivP)
    bool sameType = false
    if n > 0
        sameType := array.get(pivT, n - 1) == t
    if sameType
        float lp = array.get(pivP, n - 1)
        if (t == 1 and p > lp) or (t == -1 and p < lp)
            array.set(pivP, n - 1, p)
            array.set(pivB, n - 1, b)
    else
        array.push(pivP, p)
        array.push(pivB, b)
        array.push(pivT, t)
        if array.size(pivP) > 10
            array.shift(pivP)
            array.shift(pivB)
            array.shift(pivT)
    true

patName(int k) =>
    k == 1 ? "Double Top (M)" : k == 2 ? "Double Bottom (W)" : k == 3 ? "Symmetrical Triangle" : k == 4 ? "Ascending Triangle" : "Descending Triangle"

patExists(int key, int kind) =>
    bool ex = false
    int n = array.size(pats)
    if n > 0
        for i = 0 to n - 1
            Pat p = array.get(pats, i)
            if p.key == key and p.kind == kind
                ex := true
    ex

trimPats() =>
    while array.size(pats) > maxPats
        Pat old = array.shift(pats)
        line.delete(old.lnA)
        line.delete(old.lnB)
        if not na(old.lnC)
            line.delete(old.lnC)
        label.delete(old.lbl)
    true

killLiveTriangles() =>
    int n = array.size(pats)
    if n > 0
        for i = n - 1 to 0
            Pat p = array.get(pats, i)
            if p.kind >= 3 and p.state == 0
                line.delete(p.lnA)
                line.delete(p.lnB)
                label.delete(p.lbl)
                array.remove(pats, i)
    true

fadePat(Pat p) =>
    line.set_color(p.lnA, color.new(p.col, 82))
    line.set_color(p.lnB, color.new(p.col, 82))
    if not na(p.lnC)
        line.set_color(p.lnC, color.new(p.col, 88))
    label.set_color(p.lbl, color.new(mutedCol, 70))
    label.set_text(p.lbl, label.get_text(p.lbl) + " x")
    true

detectPatterns(float atrNow) =>
    int created = 0
    int n = array.size(pivP)

    // Double top (M) / Double bottom (W): last 3 pivots
    if n >= 3
        int t3 = array.get(pivT, n - 1)
        float pA = array.get(pivP, n - 3)
        float pB = array.get(pivP, n - 2)
        float pC = array.get(pivP, n - 1)
        int bA = array.get(pivB, n - 3)
        int bB = array.get(pivB, n - 2)
        int bC = array.get(pivB, n - 1)
        int span = bC - bA
        bool similar = math.abs(pA - pC) <= patTol * atrNow
        if span >= 8 and span <= 150 and similar
            if t3 == 1 and (math.min(pA, pC) - pB) >= patDepth * atrNow and not patExists(bC, 1)
                line m1 = line.new(bA, pA, bB, pB, color=bearCol, width=2)
                line m2 = line.new(bB, pB, bC, pC, color=bearCol, width=2)
                line m3 = line.new(bA, pB, bar_index, pB, color=color.new(bearCol, 30), style=line.style_dashed, width=1)
                label mlb = label.new(bC, pC, "M", style=label.style_label_down, color=bearCol, textcolor=color.white, size=size.small)
                array.push(pats, Pat.new(kind=1, key=bC, state=0, born=bar_index, lnA=m1, lnB=m2, lnC=m3, lbl=mlb, neck=pB, inval=math.max(pA, pC) + 0.5 * atrNow, col=bearCol))
                created += 1
            if t3 == -1 and (pB - math.max(pA, pC)) >= patDepth * atrNow and not patExists(bC, 2)
                line w1 = line.new(bA, pA, bB, pB, color=bullCol, width=2)
                line w2 = line.new(bB, pB, bC, pC, color=bullCol, width=2)
                line w3 = line.new(bA, pB, bar_index, pB, color=color.new(bullCol, 30), style=line.style_dashed, width=1)
                label wlb = label.new(bC, pC, "W", style=label.style_label_up, color=bullCol, textcolor=color.white, size=size.small)
                array.push(pats, Pat.new(kind=2, key=bC, state=0, born=bar_index, lnA=w1, lnB=w2, lnC=w3, lbl=wlb, neck=pB, inval=math.min(pA, pC) - 0.5 * atrNow, col=bullCol))
                created += 1

    // Triangles: last 4 pivots
    if n >= 4
        int t4 = array.get(pivT, n - 1)
        float q1 = array.get(pivP, n - 4)
        float q2 = array.get(pivP, n - 3)
        float q3 = array.get(pivP, n - 2)
        float q4 = array.get(pivP, n - 1)
        int c1 = array.get(pivB, n - 4)
        int c2 = array.get(pivB, n - 3)
        int c3 = array.get(pivB, n - 2)
        int c4 = array.get(pivB, n - 1)
        float h1 = t4 == 1 ? q2 : q1
        float h2 = t4 == 1 ? q4 : q3
        int hb1 = t4 == 1 ? c2 : c1
        int hb2 = t4 == 1 ? c4 : c3
        float lo1 = t4 == 1 ? q1 : q2
        float lo2 = t4 == 1 ? q3 : q4
        int lb1 = t4 == 1 ? c1 : c2
        int lb2 = t4 == 1 ? c3 : c4

        float flat = patFlat * atrNow
        bool lowerHighs = h2 < h1 - flat
        bool flatHighs = math.abs(h2 - h1) <= flat
        bool higherLows = lo2 > lo1 + flat
        bool flatLows = math.abs(lo2 - lo1) <= flat
        int tspan = c4 - c1
        float height = h1 - lo1

        int tk = 0
        if lowerHighs and higherLows
            tk := 3
        else if flatHighs and higherLows
            tk := 4
        else if flatLows and lowerHighs
            tk := 5

        if tk > 0 and height >= patDepth * atrNow and tspan >= 12 and tspan <= 200 and hb2 > hb1 and lb2 > lb1 and not patExists(c4, tk)
            float us = (h2 - h1) / (hb2 - hb1)
            float ls = (lo2 - lo1) / (lb2 - lb1)
            float uNow = h1 + us * (bar_index - hb1)
            float lNow = lo1 + ls * (bar_index - lb1)
            if uNow > lNow + 0.3 * atrNow and close <= uNow and close >= lNow
                color tcol = tk == 3 ? violCol : tk == 4 ? bullCol : bearCol
                killLiveTriangles()
                line tu = line.new(hb1, h1, bar_index, uNow, color=tcol, width=2)
                line tl = line.new(lb1, lo1, bar_index, lNow, color=tcol, width=2)
                label tlb = label.new(bar_index, (uNow + lNow) / 2, patName(tk), style=label.style_label_left, color=color.new(tcol, 20), textcolor=color.white, size=size.small)
                array.push(pats, Pat.new(kind=tk, key=c4, state=0, born=bar_index, lnA=tu, lnB=tl, lbl=tlb, ub=hb1, uy=h1, us=us, lbb=lb1, ly=lo1, ls=ls, col=tcol))
                created += 1

    trimPats()
    created

// ================= Helpers: trades / dashboard =================
delTrade(Trade t) =>
    box.delete(t.bxWin)
    box.delete(t.bxRisk)
    line.delete(t.lnEntry)
    line.delete(t.lnTp1)
    label.delete(t.lbl)
    if not na(t.lblEnd)
        label.delete(t.lblEnd)
    true

addRow(array<string> L, array<string> V, array<color> C, string l, string v, color c) =>
    array.push(L, l)
    array.push(V, v)
    array.push(C, c)
    true

// ================= Helpers: order flow (estimated) =================
fmtVol(float v) =>
    v >= 1000 ? str.tostring(v / 1000, "#.#") + "k" : v >= 100 ? str.tostring(v, "#") : v >= 10 ? str.tostring(v, "#.#") : str.tostring(v, "#.##")

// Builds an estimated footprint for the current candle from lower-timeframe candles.
// Each intrabar's volume is split into buy/sell by where it closed inside its own range,
// then spread over the price rows it touched. This is an ESTIMATE, not true bid/ask data.
calcFlow(array<float> aH, array<float> aL, array<float> aC, array<float> aV) =>
    bool ok = false
    float bt = 0.0
    float st = 0.0
    int poc = -1
    int nbi = 0
    int nsi = 0
    int stB = 0
    int stS = 0
    bool aBull = false
    bool aBear = false
    for r0 = 0 to 19
        array.set(rowBuy, r0, 0.0)
        array.set(rowSell, r0, 0.0)
        array.set(rowBI, r0, false)
        array.set(rowSI, r0, false)
    float rng = high - low
    int n = na(aH) ? 0 : array.size(aH)
    if (ofMode != "Off" or ofOn) and n > 0 and rng > syminfo.mintick * 2
        float rh = rng / nRows
        for j = 0 to n - 1
            float jh = nz(array.get(aH, j))
            float jl = nz(array.get(aL, j))
            float jc = nz(array.get(aC, j))
            float jv = nz(array.get(aV, j))
            float jr = jh - jl
            if jr > 0
                float bf = (jc - jl) / jr
                for r = 0 to nRows - 1
                    float rLo = low + r * rh
                    float ov = math.max(0.0, math.min(jh, rLo + rh) - math.max(jl, rLo)) / jr
                    if ov > 0
                        array.set(rowBuy, r, array.get(rowBuy, r) + jv * bf * ov)
                        array.set(rowSell, r, array.get(rowSell, r) + jv * (1 - bf) * ov)
            else
                int ri = math.min(nRows - 1, math.max(0, math.floor((jc - low) / rh)))
                array.set(rowBuy, ri, array.get(rowBuy, ri) + jv * 0.5)
                array.set(rowSell, ri, array.get(rowSell, ri) + jv * 0.5)

        float maxV = 0.0
        for r = 0 to nRows - 1
            float rb = array.get(rowBuy, r)
            float rs = array.get(rowSell, r)
            bt += rb
            st += rs
            if rb + rs > maxV
                maxV := rb + rs
                poc := r
        float tot = bt + st
        if tot > 0
            ok := true
            float minVol = tot * imbMinPct / 100
            int runB = 0
            int runS = 0
            for r = 0 to nRows - 1
                bool bi = false
                bool si = false
                if r >= 1
                    bi := array.get(rowBuy, r) >= imbRatio * array.get(rowSell, r - 1) and array.get(rowBuy, r) >= minVol
                if r <= nRows - 2
                    si := array.get(rowSell, r) >= imbRatio * array.get(rowBuy, r + 1) and array.get(rowSell, r) >= minVol
                array.set(rowBI, r, bi)
                array.set(rowSI, r, si)
                if bi
                    nbi += 1
                    runB += 1
                    stB := math.max(stB, runB)
                else
                    runB := 0
                if si
                    nsi += 1
                    runS += 1
                    stS := math.max(stS, runS)
                else
                    runS := 0
            int band = math.max(1, math.round(nRows * 0.3))
            float lowSell = 0.0
            float lowBuy = 0.0
            float topBuy = 0.0
            float topSell = 0.0
            for r = 0 to band - 1
                lowSell += array.get(rowSell, r)
                lowBuy += array.get(rowBuy, r)
            for r = nRows - band to nRows - 1
                topBuy += array.get(rowBuy, r)
                topSell += array.get(rowSell, r)
            aBull := lowSell / tot * 100 >= absorbPct and lowSell > lowBuy and close >= low + 0.5 * rng
            aBear := topBuy / tot * 100 >= absorbPct and topBuy > topSell and close <= low + 0.5 * rng
    [ok, bt, st, poc, nbi, nsi, stB, stS, aBull, aBear]

// ================= Swing HIGH =================
if not na(ph)
    pbar = bar_index - len
    a = atr[len]
    w = a * zoneAtr
    int sc = 0
    sc += volume[len] > volAvg[len] * volMult ? 1 : 0
    sc += rsi[len] >= rsiHi ? 1 : 0
    if not na(lastPL)
        sc += (ph - lastPL) >= swingMul * a ? 1 : 0
    int touches = 0
    for lv in hiLevels
        touches += math.abs(lv - ph) <= w ? 1 : 0
    sc += touches > 0 ? 1 : 0

    bool isHH = ph > lastPH
    string kind = na(lastPH) ? "H" : (isHH ? "HH" : "LH")
    color tcol = na(lastPH) ? mutedCol : (isHH ? bullCol : bearCol)
    if showLabels and sc >= effMinScore
        bool strong = sc >= strongScore
        label.new(pbar, ph, kind + " · " + str.tostring(sc), style=label.style_label_down, color=strong ? color.new(tcol, 15) : color.new(tcol, 100), textcolor=strong ? color.white : tcol, size=size.small)
    addZone(ph, w, pbar, true, sc, showZones and sc >= effMinScore)

    array.push(hiLevels, ph)
    if array.size(hiLevels) > 10
        array.shift(hiLevels)
    addPivot(ph, pbar, 1)
    touchLevel(ph, pbar, a * keyTol)
    lastPH := ph
    lastPHbar := pbar
    phBroken := false

    if showFib and not na(lastPL) and (ph - lastPL) >= legMul * a
        fibDir := 1
        fibStart := lastPL
        fibEnd := ph
        buildFib(lastPL, ph, lastPLbar, pbar, 1, atr * fibTol, showGold, effExt)

// ================= Swing LOW =================
if not na(pl)
    pbar = bar_index - len
    a = atr[len]
    w = a * zoneAtr
    int sc = 0
    sc += volume[len] > volAvg[len] * volMult ? 1 : 0
    sc += rsi[len] <= rsiLo ? 1 : 0
    if not na(lastPH)
        sc += (lastPH - pl) >= swingMul * a ? 1 : 0
    int touches = 0
    for lv in loLevels
        touches += math.abs(lv - pl) <= w ? 1 : 0
    sc += touches > 0 ? 1 : 0

    bool isLL = pl < lastPL
    string kind = na(lastPL) ? "L" : (isLL ? "LL" : "HL")
    color tcol = na(lastPL) ? mutedCol : (isLL ? bearCol : bullCol)
    if showLabels and sc >= effMinScore
        bool strong = sc >= strongScore
        label.new(pbar, pl, kind + " · " + str.tostring(sc), style=label.style_label_up, color=strong ? color.new(tcol, 15) : color.new(tcol, 100), textcolor=strong ? color.white : tcol, size=size.small)
    addZone(pl, w, pbar, false, sc, showZones and sc >= effMinScore)

    array.push(loLevels, pl)
    if array.size(loLevels) > 10
        array.shift(loLevels)
    addPivot(pl, pbar, -1)
    touchLevel(pl, pbar, a * keyTol)
    lastPL := pl
    lastPLbar := pbar
    plBroken := false

    if showFib and not na(lastPH) and (lastPH - pl) >= legMul * a
        fibDir := -1
        fibStart := lastPH
        fibEnd := pl
        buildFib(lastPH, pl, lastPHbar, pbar, -1, atr * fibTol, showGold, effExt)

// ================= Pattern detection (on each new pivot) =================
bool patFormed = false
if showPat and (not na(ph) or not na(pl))
    patFormed := detectPatterns(atr) > 0

// ================= Structure breaks (closed bars only) =================
brkUp = not na(lastPH) and not phBroken and close > lastPH and barstate.isconfirmed
brkDn = not na(lastPL) and not plBroken and close < lastPL and barstate.isconfirmed
chochUp = brkUp and trend == -1
bosUp   = brkUp and trend != -1
chochDn = brkDn and trend == 1
bosDn   = brkDn and trend != 1

if brkUp
    if showStruct and (chochUp or not isClean)
        midX = math.round((lastPHbar + bar_index) / 2.0)
        line.new(lastPHbar, lastPH, bar_index, lastPH, color=color.new(bullCol, chochUp ? 0 : 40), style=line.style_dashed, width=chochUp ? 2 : 1)
        label.new(midX, lastPH, chochUp ? "CHoCH" : "BOS", style=label.style_label_down, color=chochUp ? bullCol : color.new(bullCol, 100), textcolor=chochUp ? color.white : bullCol, size=size.small)
    phBroken := true
    trend := 1

if brkDn
    if showStruct and (chochDn or not isClean)
        midX = math.round((lastPLbar + bar_index) / 2.0)
        line.new(lastPLbar, lastPL, bar_index, lastPL, color=color.new(bearCol, chochDn ? 0 : 40), style=line.style_dashed, width=chochDn ? 2 : 1)
        label.new(midX, lastPL, chochDn ? "CHoCH" : "BOS", style=label.style_label_up, color=chochDn ? bearCol : color.new(bearCol, 100), textcolor=chochDn ? color.white : bearCol, size=size.small)
    plBroken := true
    trend := -1

// ================= Zones: extend until broken =================
int nz = array.size(zBox)
if nz > 0
    for i = 0 to nz - 1
        if array.get(zAlive, i)
            box zb = array.get(zBox, i)
            bool isRes = array.get(zRes, i)
            if not na(zb)
                box.set_right(zb, bar_index)
            bool broken = isRes ? close > array.get(zTop, i) : close < array.get(zBot, i)
            if broken and barstate.isconfirmed
                array.set(zAlive, i, false)
                if not na(zb)
                    box.set_bgcolor(zb, color.new(isRes ? bearCol : bullCol, 97))
                    box.set_border_color(zb, color.new(isRes ? bearCol : bullCol, 92))

// ================= Patterns: update / confirm / fail =================
bool patUp = false
bool patDn = false
int np = array.size(pats)
if np > 0
    for i = 0 to np - 1
        Pat p = array.get(pats, i)
        if p.state == 0
            if p.kind <= 2
                line.set_x2(p.lnC, bar_index)
                if barstate.isconfirmed
                    if p.kind == 1 and close < p.neck
                        p.state := 1
                        label.set_text(p.lbl, "M ✓")
                        line.set_style(p.lnC, line.style_solid)
                        patDn := true
                    else if p.kind == 2 and close > p.neck
                        p.state := 1
                        label.set_text(p.lbl, "W ✓")
                        line.set_style(p.lnC, line.style_solid)
                        patUp := true
                    else if (p.kind == 1 and close > p.inval) or (p.kind == 2 and close < p.inval) or (bar_index - p.born > 150)
                        p.state := 2
                        fadePat(p)
            else
                float uN = p.uy + p.us * (bar_index - p.ub)
                float lN = p.ly + p.ls * (bar_index - p.lbb)
                line.set_xy2(p.lnA, bar_index, uN)
                line.set_xy2(p.lnB, bar_index, lN)
                if barstate.isconfirmed
                    if close > uN
                        p.state := 1
                        label.set_text(p.lbl, patName(p.kind) + " ↑")
                        patUp := true
                    else if close < lN
                        p.state := 1
                        label.set_text(p.lbl, patName(p.kind) + " ↓")
                        patDn := true
                    else if uN <= lN or (bar_index - p.born > 150)
                        p.state := 2
                        fadePat(p)
if patUp
    lastPatUpBar := bar_index
if patDn
    lastPatDnBar := bar_index

// ================= Fibonacci touch detection =================
tolNow = atr * fibTol
bool touchAny = false
bool touchConf = false
nFib = array.size(fibPrices)
if nFib > 0
    for j = 0 to nFib - 1
        pr = array.get(fibPrices, j)
        if low <= pr + tolNow and high >= pr - tolNow
            touchAny := true
            if array.get(fibConf, j)
                touchConf := true

bool touchConfRetr = false
int nRetr = math.min(4, array.size(fibPrices))
if nRetr > 0
    for j2 = 0 to nRetr - 1
        if array.get(fibConf, j2)
            float prr = array.get(fibPrices, j2)
            if low <= prr + tolNow and high >= prr - tolNow
                touchConfRetr := true

fibTouch     = touchAny and not touchAny[1] and barstate.isconfirmed
fibTouchConf = touchConf and not touchConf[1] and barstate.isconfirmed
plotshape(fibTouchConf, "Fib + zone confluence", shape.diamond, location.abovebar, goldCol, size=size.tiny)

// ================= Order flow (estimated) =================
[iH, iL, iC, iV] = request.security_lower_tf(syminfo.tickerid, ltf, [high, low, close, volume], ignore_invalid_timeframe = true)
[ofOk, bTot, sTot, pocR, nBI, nSI, stackB, stackS, absBull, absBear] = calcFlow(iH, iL, iC, iV)

float oTot = bTot + sTot
float dlt = bTot - sTot
float dltPct = oTot > 0 ? dlt / oTot * 100 : 0.0
if ofOk
    cvd += dlt
bool dConfL = ofOk and dltPct >= deltaMin
bool dConfS = ofOk and dltPct <= -deltaMin
bool flowL = ofOk and (absBull or stackB >= stackMin)
bool flowS = ofOk and (absBear or stackS >= stackMin)

// markers (drawn when the candle closes, only for the most recent candles)
bool ofWin = bar_index > last_bar_index - ofBars
if ofMode != "Off" and ofOk and ofWin and barstate.isconfirmed
    float rhD = (high - low) / nRows
    float pocY = low + (pocR + 0.5) * rhD
    line.new(time, pocY, time_close, pocY, xloc=xloc.bar_time, color=color.new(goldCol, 5), width=2)
    if absBull
        label.new(bar_index, low, "A", style=label.style_label_up, color=color.new(bullCol, 20), textcolor=color.white, size=size.tiny)
    if absBear
        label.new(bar_index, high, "A", style=label.style_label_down, color=color.new(bearCol, 20), textcolor=color.white, size=size.tiny)
    for r = 0 to nRows - 1
        float ry = low + (r + 0.5) * rhD
        if stackB >= stackMin and array.get(rowBI, r)
            label.new(bar_index, ry, "", style=label.style_diamond, color=bullCol, size=size.tiny)
        if stackS >= stackMin and array.get(rowSI, r)
            label.new(bar_index, ry, "", style=label.style_diamond, color=bearCol, size=size.tiny)

// footprint numbers (sell x buy per row) on the last few candles
if ofMode == "Footprint" and ofOk and bar_index > last_bar_index - fpBars and barstate.isconfirmed
    float rhF = (high - low) / nRows
    for r = 0 to nRows - 1
        float ry = low + (r + 0.5) * rhF
        float rbv = array.get(rowBuy, r)
        float rsv = array.get(rowSell, r)
        bool isPoc = r == pocR
        color tcl = array.get(rowBI, r) ? bullCol : array.get(rowSI, r) ? bearCol : mutedCol
        label.new(bar_index, ry, fmtVol(rsv) + " x " + fmtVol(rbv), style=label.style_label_center, color=isPoc ? color.new(goldCol, 70) : color.new(color.black, 100), textcolor=isPoc ? color.white : tcl, size=size.tiny)
    label.new(bar_index, low - rhF * 0.5, "Δ " + (dlt >= 0 ? "+" : "") + str.tostring(dlt, "#.##") + " (" + (dltPct >= 0 ? "+" : "") + str.tostring(dltPct, "#") + "%)", style=label.style_label_up, color=color.new(color.black, 100), textcolor=dlt >= 0 ? bullCol : bearCol, size=size.tiny)

// ================= Setup scoring (0-10) =================
// location inputs: live zones, key levels, golden zone
float zLong = 0.0
float zShort = 0.0
float zLongBot = na
float zShortTop = na
int nz2 = array.size(zPrice)
if nz2 > 0
    for i = 0 to nz2 - 1
        if array.get(zAlive, i)
            if low <= array.get(zTop, i) and high >= array.get(zBot, i)
                int zs = array.get(zScore, i)
                if array.get(zRes, i)
                    zShort := math.max(zShort, zs)
                    zShortTop := na(zShortTop) ? array.get(zTop, i) : math.max(zShortTop, array.get(zTop, i))
                else
                    zLong := math.max(zLong, zs)
                    zLongBot := na(zLongBot) ? array.get(zBot, i) : math.min(zLongBot, array.get(zBot, i))

bool keyLongT = false
bool keyShortT = false
float tolK = atr * keyTol
int nk2 = array.size(kPrice)
if nk2 > 0
    for i = 0 to nk2 - 1
        if array.get(kCount, i) >= keyMin
            float kp = array.get(kPrice, i)
            if low <= kp + tolK and high >= kp - tolK
                if kp <= close
                    keyLongT := true
                if kp >= close
                    keyShortT := true

bool goldTouch = false
if not na(fibEnd) and fibDir != 0
    float legG = math.abs(fibEnd - fibStart)
    float g1 = fibEnd - fibDir * 0.618 * legG
    float g2 = fibEnd - fibDir * 0.786 * legG
    goldTouch := low <= math.max(g1, g2) and high >= math.min(g1, g2)

// With order flow available: fib = 1 point, order flow = 2 points (delta confirms + absorption/stacked imbalance).
// Without it (older bars / chart too low): fib = 2 points, volume spike = 1 point. Max is 10 either way.
bool ofUse = ofOn and ofOk

int scL = 0
scL += htfBias == 1 ? 2 : 0
scL += trend == 1 ? 1 : 0
scL += zLong >= 3 ? 2 : zLong >= 2 ? 1 : 0
scL += keyLongT ? 1 : 0
bool fibL1 = fibDir == 1 and goldTouch
bool fibL2 = fibDir == 1 and touchConfRetr
scL += ofUse ? ((fibL1 or fibL2) ? 1 : 0) : ((fibL1 ? 1 : 0) + (fibL2 ? 1 : 0))
scL += (bar_index - lastPatUpBar) <= 20 ? 1 : 0
scL += ofUse ? ((dConfL ? 1 : 0) + (flowL ? 1 : 0)) : (volume > volAvg * volMult ? 1 : 0)

int scS = 0
scS += htfBias == -1 ? 2 : 0
scS += trend == -1 ? 1 : 0
scS += zShort >= 3 ? 2 : zShort >= 2 ? 1 : 0
scS += keyShortT ? 1 : 0
bool fibS1 = fibDir == -1 and goldTouch
bool fibS2 = fibDir == -1 and touchConfRetr
scS += ofUse ? ((fibS1 or fibS2) ? 1 : 0) : ((fibS1 ? 1 : 0) + (fibS2 ? 1 : 0))
scS += (bar_index - lastPatDnBar) <= 20 ? 1 : 0
scS += ofUse ? ((dConfS ? 1 : 0) + (flowS ? 1 : 0)) : (volume > volAvg * volMult ? 1 : 0)

bool locL = zLong >= 2 or keyLongT or (fibDir == 1 and goldTouch)
bool locS = zShort >= 2 or keyShortT or (fibDir == -1 and goldTouch)
bool regimeOk = not useRegime or adxV >= adxMin
bool sessOk = not useSession or ((sessAsia and hrUTC >= 0 and hrUTC < 8) or (sessLondon and hrUTC >= 7 and hrUTC < 16) or (sessNY and hrUTC >= 13 and hrUTC < 22))
bool candL = bullTrig and locL and scL >= sigMin
bool candS = bearTrig and locS and scS >= sigMin

// ================= Signal -> trade plan =================
bool sigLong = false
bool sigShort = false
bool freeSlot = true
if not na(cur)
    freeSlot := cur.state == 2

if sigOn and barstate.isconfirmed and freeSlot and regimeOk and sessOk and (bar_index - lastSigBar >= cooldown) and (candL or candS)
    bool goLong = candL and (not candS or scL >= scS)
    int dirN = goLong ? 1 : -1
    int scN = goLong ? scL : scS
    float zbase = goLong ? zLongBot : zShortTop
    float slRaw = goLong ? math.min(low, na(zbase) ? low : zbase) - slBuf * atr : math.max(high, na(zbase) ? high : zbase) + slBuf * atr
    float entryP = close
    float slP = math.abs(entryP - slRaw) < 0.5 * atr ? entryP - dirN * 0.5 * atr : slRaw
    float riskF = math.abs(entryP - slP)
    if riskF > 0 and riskF <= maxRiskAtr * atr
        float tp1P = entryP + dirN * rr1 * riskF
        float tp2P = entryP + dirN * rr2 * riskF
        int grd = scN >= gradeA ? 2 : 1
        box bw = box.new(bar_index, math.max(entryP, tp2P), bar_index + 1, math.min(entryP, tp2P), border_color=color.new(bullCol, 100), bgcolor=color.new(bullCol, 86))
        box br = box.new(bar_index, math.max(entryP, slP), bar_index + 1, math.min(entryP, slP), border_color=color.new(bearCol, 100), bgcolor=color.new(bearCol, 86))
        line le = line.new(bar_index, entryP, bar_index + 1, entryP, color=color.new(color.white, 20), width=1)
        line lt = line.new(bar_index, tp1P, bar_index + 1, tp1P, color=color.new(bullCol, 20), style=line.style_dashed, width=1)
        string txt = (goLong ? "LONG " : "SHORT ") + (grd == 2 ? "A " : "B ") + str.tostring(scN)
        label lb = label.new(bar_index, goLong ? low : high, txt, style=goLong ? label.style_label_up : label.style_label_down, color=goLong ? bullCol : bearCol, textcolor=color.white, size=size.small)
        cur := Trade.new(dir=dirN, grade=grd, score=scN, entry=entryP, slInit=slP, sl=slP, tp1=tp1P, tp2=tp2P, risk=riskF, bar0=bar_index, state=0, locked=0.0, outcome="open", bxWin=bw, bxRisk=br, lnEntry=le, lnTp1=lt, lbl=lb)
        array.push(plans, cur)
        while array.size(plans) > maxPlans
            Trade oldT = array.shift(plans)
            delTrade(oldT)
        lastSigBar := bar_index
        sigLong := goLong
        sigShort := not goLong
        if webhookOn
            alert('{"signal":"' + (goLong ? "long" : "short") + '","grade":"' + (grd == 2 ? "A" : "B") + '","score":' + str.tostring(scN) + ',"symbol":"' + syminfo.ticker + '","entry":' + str.tostring(entryP) + ',"sl":' + str.tostring(slP) + ',"tp1":' + str.tostring(tp1P) + ',"tp2":' + str.tostring(tp2P) + '}', alert.freq_once_per_bar_close)

// ================= Trade simulation (statistics) =================
bool evTP1 = false
bool evClose = false
if not na(cur)
    if cur.state < 2 and bar_index > cur.bar0
        int d = cur.dir
        box.set_right(cur.bxWin, bar_index)
        box.set_right(cur.bxRisk, bar_index)
        line.set_x2(cur.lnEntry, bar_index)
        line.set_x2(cur.lnTp1, bar_index)
        if barstate.isconfirmed
            bool hitSL = d == 1 ? low <= cur.sl : high >= cur.sl
            bool hitT1 = d == 1 ? high >= cur.tp1 : low <= cur.tp1
            bool hitT2 = d == 1 ? high >= cur.tp2 : low <= cur.tp2
            float rawR = na
            string how = ""
            if cur.state == 0
                if hitSL
                    rawR := -1.0
                    how := "SL"
                else if hitT1
                    cur.state := 1
                    cur.locked := tp1Share * rr1
                    cur.sl := cur.entry
                    evTP1 := true
                    if hitT2
                        rawR := cur.locked + (1 - tp1Share) * rr2
                        how := "TP2"
            else
                if hitSL
                    rawR := cur.locked
                    how := "BE"
                else if hitT2
                    rawR := cur.locked + (1 - tp1Share) * rr2
                    how := "TP2"
            if na(rawR) and (bar_index - cur.bar0) >= maxHold
                float openR = (close - cur.entry) * d / cur.risk
                rawR := cur.state == 1 ? cur.locked + (1 - tp1Share) * openR : openR
                how := "Time"
            if not na(rawR)
                float costR = (cur.entry * feePct / 100 * 2) / cur.risk
                float resR = rawR - costR
                cur.result := resR
                cur.outcome := how
                cur.state := 2
                evClose := true
                nTrades += 1
                if resR > 0
                    nWins += 1
                    sumWin += resR
                else
                    sumLoss += -resR
                sumR += resR
                equity += resR
                peakEq := math.max(peakEq, equity)
                maxDD := math.max(maxDD, peakEq - equity)
                float exitY = how == "SL" ? cur.slInit : (how == "TP2" ? cur.tp2 : (how == "BE" ? cur.entry : close))
                cur.lblEnd := label.new(bar_index, exitY, how + " " + (resR >= 0 ? "+" : "") + str.tostring(resR, "#.##") + "R", style=label.style_label_left, color=color.new(color.black, 100), textcolor=resR >= 0 ? bullCol : bearCol, size=size.small)

// ================= Last bar: right-edge labels, key levels, HTF levels, focus =================
float nearKeyP = na
if barstate.islast
    for fl in fibLabels
        label.set_x(fl, bar_index + 3)

    for kl in keyLines
        line.delete(kl)
    for kb in keyLbls
        label.delete(kb)
    array.clear(keyLines)
    array.clear(keyLbls)

    array<float> ys = array.new<float>()
    for fp in fibPrices
        array.push(ys, fp)
    float gapY = 0.45 * atr

    if showKey
        array<int> sel = array.new<int>()
        int nk = array.size(kPrice)
        if nk > 0
            array<bool> used = array.new<bool>(nk, false)
            if focusMode
                for side = 0 to 1
                    for s = 1 to focusN
                        int bi = -1
                        float bd = na
                        for m = 0 to nk - 1
                            if not array.get(used, m) and array.get(kCount, m) >= keyMin
                                float kpm = array.get(kPrice, m)
                                bool onSide = side == 0 ? kpm > close : kpm <= close
                                if onSide
                                    float dm = math.abs(kpm - close)
                                    if na(bd) or dm < bd
                                        bd := dm
                                        bi := m
                        if bi >= 0
                            array.set(used, bi, true)
                            array.push(sel, bi)
            else
                for s = 1 to effKeyMax
                    int bi = -1
                    int bc = 0
                    for m = 0 to nk - 1
                        if not array.get(used, m)
                            int cm = array.get(kCount, m)
                            if cm >= keyMin and (cm > bc or (cm == bc and bi >= 0 and array.get(kLast, m) > array.get(kLast, bi)))
                                bi := m
                                bc := cm
                    if bi >= 0
                        array.set(used, bi, true)
                        array.push(sel, bi)
        int ns = array.size(sel)
        if ns > 0
            for e = 0 to ns - 1
                int ki = array.get(sel, e)
                float lp = array.get(kPrice, ki)
                int kc = array.get(kCount, ki)
                color lc = lp > close ? bearCol : bullCol
                int x0 = math.max(array.get(kFirst, ki), bar_index - 480)
                array.push(keyLines, line.new(x0, lp, bar_index, lp, extend=extend.right, color=color.new(lc, 30), width=kc >= 5 ? 3 : (kc >= 4 ? 2 : 1)))
                if slotFree(ys, lp, gapY)
                    array.push(keyLbls, label.new(bar_index + 3, lp, str.tostring(lp, format.mintick) + " · " + str.tostring(kc) + "x", style=label.style_none, textcolor=lc, size=size.small))
                    array.push(ys, lp)
                if na(nearKeyP) or math.abs(lp - close) < math.abs(nearKeyP - close)
                    nearKeyP := lp

    if showPD
        drawHtf(pdh, "PDH", dayCol, ys, gapY)
        drawHtf(pdl, "PDL", dayCol, ys, gapY)
    if showPW
        drawHtf(pwh, "PWH", weekCol, ys, gapY)
        drawHtf(pwl, "PWL", weekCol, ys, gapY)
    if effPM
        drawHtf(pmh, "PMH", monthCol, ys, gapY)
        drawHtf(pml, "PML", monthCol, ys, gapY)

    // focus mode: hide zones that are not among the nearest ones to price
    if focusMode
        int nzf = array.size(zBox)
        if nzf > 0
            array<bool> keep = array.new<bool>(nzf, false)
            for side2 = 0 to 1
                for s2 = 1 to focusN
                    int bz = -1
                    float bdz = na
                    for q2 = 0 to nzf - 1
                        if array.get(zAlive, q2) and not array.get(keep, q2) and not na(array.get(zBox, q2))
                            float mid = array.get(zPrice, q2)
                            bool onS = side2 == 0 ? mid > close : mid <= close
                            if onS
                                float dz = math.abs(mid - close)
                                if na(bdz) or dz < bdz
                                    bdz := dz
                                    bz := q2
                    if bz >= 0
                        array.set(keep, bz, true)
            for q3 = 0 to nzf - 1
                box zbx = array.get(zBox, q3)
                if not na(zbx) and not array.get(keep, q3)
                    box.set_bgcolor(zbx, color.new(color.white, 100))
                    box.set_border_color(zbx, color.new(color.white, 100))

// ================= Dashboard =================
var table info = table.new(tpos, 2, 22)
if barstate.islast and showTable
    color trendCol = trend == 1 ? bullCol : trend == -1 ? bearCol : color.white
    string trendTxt = trend == 1 ? "Up" : trend == -1 ? "Down" : "-"
    color htfCol = htfBias == 1 ? bullCol : htfBias == -1 ? bearCol : color.white
    string htfTxt = htfBias == 1 ? "Bullish" : htfBias == -1 ? "Bearish" : "-"
    string regimeTxt = (adxV >= 25 ? "Strong trend" : adxV >= 18 ? "Trend" : "Range") + " (ADX " + str.tostring(adxV, "#") + ")"
    string sessTxt = not useSession ? "All" : (sessOk ? "Active" : "Off")
    string legTxt = fibDir == 1 ? "Up swing" : fibDir == -1 ? "Down swing" : "-"

    string nearTxt = "-"
    float bestD = na
    int n2 = array.size(fibPrices)
    if n2 > 0
        for q = 0 to n2 - 1
            float dq = math.abs(close - array.get(fibPrices, q))
            if na(bestD) or dq < bestD
                bestD := dq
                nearTxt := array.get(fibNames, q)
    string goldTxt = "-"
    if not na(fibEnd)
        float legL = math.abs(fibEnd - fibStart)
        float ga = fibEnd - fibDir * 0.618 * legL
        float gb = fibEnd - fibDir * 0.786 * legL
        goldTxt := (close <= math.max(ga, gb) and close >= math.min(ga, gb)) ? "Yes" : "No"

    string patTxt = "-"
    color patCol = color.white
    int npp = array.size(pats)
    if npp > 0
        Pat lastP = array.get(pats, npp - 1)
        patTxt := patName(lastP.kind) + (lastP.state == 1 ? " ✓" : lastP.state == 2 ? " x" : "")
        patCol := lastP.col
    string keyTxt = na(nearKeyP) ? "-" : str.tostring(nearKeyP, format.mintick) + " (" + str.tostring((nearKeyP / close - 1) * 100, "#.##") + "%)"

    string setupTxt = "None"
    color setupCol = mutedCol
    string entryTxt = "-"
    string slTxt = "-"
    string tpTxt = "-"
    string sizeTxt = "-"
    if not na(cur)
        string stx = cur.state == 0 ? "open" : cur.state == 1 ? "TP1 hit" : cur.outcome + " " + (cur.result >= 0 ? "+" : "") + str.tostring(cur.result, "#.##") + "R"
        setupTxt := (cur.dir == 1 ? "LONG " : "SHORT ") + (cur.grade == 2 ? "A " : "B ") + str.tostring(cur.score) + "/10 · " + stx
        setupCol := cur.dir == 1 ? bullCol : bearCol
        entryTxt := str.tostring(cur.entry, format.mintick)
        slTxt := str.tostring(cur.slInit, format.mintick)
        tpTxt := str.tostring(cur.tp1, format.mintick) + " / " + str.tostring(cur.tp2, format.mintick)
        float qty = (acct * riskPct / 100) / cur.risk
        float posVal = qty * cur.entry
        sizeTxt := str.tostring(qty, "#.####") + " ($" + str.tostring(posVal, "#") + ")" + (posVal > acct ? " lev x" + str.tostring(posVal / acct, "#.#") : "")

    float wr = nTrades > 0 ? nWins * 100.0 / nTrades : na
    float avgR = nTrades > 0 ? sumR / nTrades : na
    float pf = sumLoss > 0 ? sumWin / sumLoss : na
    string statsShort = nTrades == 0 ? "no trades yet" : str.tostring(wr, "#") + "% win · " + str.tostring(avgR, "#.##") + "R avg · " + str.tostring(nTrades) + " trades"

    string flowTxt = "n/a (needs lower-timeframe data)"
    color flowCol = mutedCol
    if ofOk
        flowTxt := "Δ " + (dltPct >= 0 ? "+" : "") + str.tostring(dltPct, "#") + "%" + (absBull ? " · bull absorption" : absBear ? " · bear absorption" : "") + (stackB >= stackMin ? " · buy stack" : stackS >= stackMin ? " · sell stack" : "")
        flowCol := dltPct >= deltaMin ? bullCol : dltPct <= -deltaMin ? bearCol : color.white
    string cvdTxt = ofOk ? (cvd > cvd[10] ? "rising" : "falling") : "-"
    color cvdCol = ofOk ? (cvd > cvd[10] ? bullCol : bearCol) : mutedCol

    array<string> rl = array.new<string>()
    array<string> rv = array.new<string>()
    array<color>  rc = array.new<color>()
    if isClean
        addRow(rl, rv, rc, "Bias", trendTxt + " · HTF " + htfTxt, trendCol)
        addRow(rl, rv, rc, "Regime", regimeTxt, color.white)
        addRow(rl, rv, rc, "Setup", setupTxt, setupCol)
        addRow(rl, rv, rc, "Entry / Stop", entryTxt + " / " + slTxt, color.white)
        addRow(rl, rv, rc, "Size", sizeTxt, color.white)
        addRow(rl, rv, rc, "Flow", flowTxt, flowCol)
        addRow(rl, rv, rc, "Stats", statsShort, color.white)
    else if isFull
        addRow(rl, rv, rc, "Trend", trendTxt, trendCol)
        addRow(rl, rv, rc, "HTF bias", htfTxt, htfCol)
        addRow(rl, rv, rc, "Regime", regimeTxt, color.white)
        addRow(rl, rv, rc, "Session", sessTxt, color.white)
        addRow(rl, rv, rc, "Pattern", patTxt, patCol)
        addRow(rl, rv, rc, "Key level", keyTxt, mutedCol)
        addRow(rl, rv, rc, "Order flow", flowTxt, flowCol)
        addRow(rl, rv, rc, "CVD (10 bars)", cvdTxt, cvdCol)
        addRow(rl, rv, rc, "Fib swing", legTxt, color.white)
        addRow(rl, rv, rc, "Nearest fib", nearTxt, goldCol)
        addRow(rl, rv, rc, "Golden zone", goldTxt, goldTxt == "Yes" ? goldCol : color.white)
        addRow(rl, rv, rc, "Setup", setupTxt, setupCol)
        addRow(rl, rv, rc, "Entry", entryTxt, color.white)
        addRow(rl, rv, rc, "Stop", slTxt, bearCol)
        addRow(rl, rv, rc, "TP1 / TP2", tpTxt, bullCol)
        addRow(rl, rv, rc, "Size", sizeTxt, color.white)
        addRow(rl, rv, rc, "Trades / Win", str.tostring(nTrades) + " / " + (nTrades > 0 ? str.tostring(wr, "#") + "%" : "-"), color.white)
        addRow(rl, rv, rc, "Avg R / PF", (nTrades > 0 ? str.tostring(avgR, "#.##") : "-") + " / " + (na(pf) ? "-" : str.tostring(pf, "#.##")), color.white)
        addRow(rl, rv, rc, "Max drawdown", str.tostring(maxDD, "#.##") + "R", color.white)
    else
        addRow(rl, rv, rc, "Trend / HTF", trendTxt + " / " + htfTxt, trendCol)
        addRow(rl, rv, rc, "Regime", regimeTxt, color.white)
        addRow(rl, rv, rc, "Pattern", patTxt, patCol)
        addRow(rl, rv, rc, "Key level", keyTxt, mutedCol)
        addRow(rl, rv, rc, "Order flow", flowTxt, flowCol)
        addRow(rl, rv, rc, "Setup", setupTxt, setupCol)
        addRow(rl, rv, rc, "Entry / Stop", entryTxt + " / " + slTxt, color.white)
        addRow(rl, rv, rc, "Targets", tpTxt, bullCol)
        addRow(rl, rv, rc, "Size", sizeTxt, color.white)
        addRow(rl, rv, rc, "Stats", statsShort, color.white)
        addRow(rl, rv, rc, "PF / Max DD", (na(pf) ? "-" : str.tostring(pf, "#.##")) + " / " + str.tostring(maxDD, "#.##") + "R", color.white)

    int rows = array.size(rl)
    for r = 0 to 21
        if r < rows
            table.cell(info, 0, r, array.get(rl, r), text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#0B1220, 15))
            table.cell(info, 1, r, array.get(rv, r), text_color=array.get(rc, r), text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#0B1220, 15))
        else
            table.cell(info, 0, r, "", text_size=size.tiny, bgcolor=color.new(color.black, 100))
            table.cell(info, 1, r, "", text_size=size.tiny, bgcolor=color.new(color.black, 100))

// ================= Alerts =================
alertcondition(sigLong, "Setup LONG", "New LONG setup (see chart for grade, entry, stop, targets)")
alertcondition(sigShort, "Setup SHORT", "New SHORT setup (see chart for grade, entry, stop, targets)")
alertcondition(evTP1, "Trade: target 1 hit", "Target 1 hit, stop moved to entry")
alertcondition(evClose, "Trade closed", "Trade closed (target, stop or time)")
alertcondition(chochUp, "CHoCH up (possible reversal up)", "Bullish CHoCH")
alertcondition(chochDn, "CHoCH down (possible reversal down)", "Bearish CHoCH")
alertcondition(bosUp, "BOS up (trend continuation)", "Bullish BOS")
alertcondition(bosDn, "BOS down (trend continuation)", "Bearish BOS")
alertcondition(fibTouch, "Price at Fibonacci level", "Price touched a Fibonacci level")
alertcondition(fibTouchConf, "Price at Fibonacci level + zone confluence", "Price touched a Fibonacci level that overlaps a live zone")
alertcondition(patFormed, "Chart pattern formed", "A new chart pattern (M / W / triangle) was detected")
alertcondition(patUp, "Pattern breakout UP (bullish)", "Bullish pattern breakout (W or triangle up)")
alertcondition(patDn, "Pattern breakdown DOWN (bearish)", "Bearish pattern breakdown (M or triangle down)")
alertcondition(ofOk and absBull and barstate.isconfirmed, "Bullish absorption", "Bullish absorption at the candle low (estimated)")
alertcondition(ofOk and absBear and barstate.isconfirmed, "Bearish absorption", "Bearish absorption at the candle high (estimated)")
alertcondition(ofOk and stackB >= stackMin and barstate.isconfirmed, "Buy imbalance stack", "Stacked buy imbalances (estimated)")
alertcondition(ofOk and stackS >= stackMin and barstate.isconfirmed, "Sell imbalance stack", "Stacked sell imbalances (estimated)")
